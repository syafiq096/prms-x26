{
  "name": "prms-x26",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "pnpm": {
    "overrides": {
      "graphql-ws": "5.16.0"
    }
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @prms/api --filter @prms/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test && pnpm --filter @prms/api test:e2e",
    "test:migrations": "pnpm --filter @prms/api test:migrations",
    "typecheck": "pnpm -r typecheck",
    "migration:create": "pnpm --filter @prms/api migration:create",
    "migration:generate": "pnpm --filter @prms/api migration:generate",
    "migration:run": "pnpm --filter @prms/api migration:run",
    "migration:show": "pnpm --filter @prms/api migration:show",
    "migration:revert": "pnpm --filter @prms/api migration:revert"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
